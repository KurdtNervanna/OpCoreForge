# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# PyInstaller: the scratch tree and the built executable are this machine's
# intermediate state, not source. BUILD_EXE.bat regenerates both.
build/OpCoreForge/
build/file_version_info.txt
dist/

# The pre-seeded payload: ~40 MB of OpenCore, kexts and ACPI tools downloaded
# from upstream. Regenerated by build/make_seed.py, so it does not belong in
# history where every refresh would be another 40 MB.
src/seed/

# Release archives. These belong on the Releases page, not in the tree.
OpCoreForge-*.zip

# Anything a run leaves behind, beside the executable or in the repo.
OpCoreForge_Data/
_run/
_fixture/
_fixture_unsupported/
_shots/
_testdata/
_testdata_window/
*.log

# OS noise
.DS_Store
Thumbs.db
